NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
META_API_VERSION=v23.0
ANTHROPIC_API_KEY=
# Conector GA4 (OAuth2 Google — ver ETAPA2-GA4 Anexo A). Redirect URI byte a byte
# igual ao registrado no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/connectors/ga4/oauth/callback
# Conector HubSpot (OAuth2 — ver ETAPA-HUBSPOT.md Anexo A). Redirect URI byte a
# byte igual ao registrado no app do HubSpot. O CLIENT_SECRET também valida a
# assinatura v3 dos webhooks em /api/hooks/hubspot.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_OAUTH_REDIRECT_URI=http://localhost:3000/api/connectors/hubspot/oauth/callback
# Opcional: sobrescreve os escopos OAuth (separados por espaço). Default:
# oauth crm.objects.contacts.read crm.objects.deals.read crm.objects.companies.read crm.schemas.deals.read
# HUBSPOT_OAUTH_SCOPES=
