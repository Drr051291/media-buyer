NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
META_API_VERSION=v23.0
ANTHROPIC_API_KEY=
# Conector GA4 (OAuth2 Google — ver ETAPA2-GA4 Anexo A). Redirect URI byte a byte
# igual ao registrado no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/connectors/ga4/oauth/callback
# Provider Google Ads (ETAPA3GOOGLEADS Anexo A). Reusa o mesmo projeto Google
# Cloud do GA4; developer token e redirect URI sao proprios do Google Ads.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_OAUTH_REDIRECT_URI=http://localhost:3000/api/providers/google-ads/oauth/callback
